<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Lets Play Services download the Subject Segmentation model right
         after install, so the first "Remove Background" tap doesn't have
         to wait on a cold download. See `com.google.mlkit.vision.DEPENDENCIES`
         docs — value is a comma-separated list of ML Kit unbundled models. -->
    <meta-data
      android:name="com.google.mlkit.vision.DEPENDENCIES"
      android:value="subject_segment" />
  </application>
</manifest>
